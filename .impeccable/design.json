      "css": ".ds-field{font-family:var(--tracepilot-font);font-size:14px;display:grid;gap:8px;color:var(--foreground)}.ds-input{font-family:var(--tracepilot-font);font-size:14px;height:44px;padding:4px 12px;border:1px solid var(--input);border-radius:var(--radius);background:var(--card);color:var(--foreground)}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring) 30%,transparent)}:host-context(.dark) .ds-input{background:color-mix(in srgb,var(--input) 30%,transparent)}@media(max-width:767px){.ds-input{font-size:16px}}"
